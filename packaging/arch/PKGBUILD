# Maintainer: Secure PIN Maintainers <steace@coderage.pro>
pkgname=tpm-pin
pkgver=1.0.5
pkgrel=1
pkgdesc="Windows Hello-style TPM 2.0 PIN authentication for Linux (PAM & GTK4 Settings)"
arch=('x86_64' 'x86_64_v3' 'x86_64_v4' 'aarch64')
url="https://github.com/steacep/secure-pin-for-linux"
license=('GPL-3.0-or-later')
depends=('glibc' 'pam' 'tpm2-tss' 'openssl' 'polkit' 'python' 'python-gobject' 'gtk4' 'libadwaita')
optdepends=(
    'gnome-keyring: Auto-unlock GNOME or COSMIC login keyring with PIN'
    'kwallet-pam: Auto-unlock KDE Plasma KWallet with PIN'
)
makedepends=('cmake' 'gcc' 'pkgconf')
install=tpm-pin.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -S "$srcdir/$pkgname-$pkgver" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib/tpm-pin \
        -DINSTALL_PAM_CONFIGS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
