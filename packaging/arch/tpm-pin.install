post_install() {
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/tpm-pin.conf >/dev/null 2>&1 || true
    fi
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload >/dev/null 2>&1 || true
        udevadm trigger --action=change --subsystem-match=tpmrm >/dev/null 2>&1 || true
    fi
    if [ -x /usr/bin/tpm-pin-ctl ]; then
        /usr/bin/tpm-pin-ctl pam enable >/dev/null 2>&1 || true
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if [ -x /usr/bin/tpm-pin-ctl ]; then
        /usr/bin/tpm-pin-ctl pam disable >/dev/null 2>&1 || true
    fi
}
