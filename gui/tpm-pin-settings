            return
        if _has_control_chars(pin):
            self._show_err("PIN cannot contain newline or control characters.")
            return

        input_data = f"{pin}\n"
        self.row_pin.set_text("")

        self._busy = True
        self.btn_verify.set_sensitive(False)
        self.btn_cancel.set_sensitive(False)

        target_user = self.parent_win.state.get("user")
        cmd = ["verify", "--user", target_user] if target_user and target_user != "unknown" else ["verify"]

        def on_done(ok, msg):
            self._busy = False
            self.btn_verify.set_sensitive(True)
            self.btn_cancel.set_sensitive(True)
            self.parent_win.refresh_ui_async()
            if ok:
                self.close()
                if "keyring password successfully unsealed" in (msg or "").lower():
                    self.parent_win.add_toast(Adw.Toast.new("PIN verified against TPM 2.0 (keyring unsealed)."))
                else:
