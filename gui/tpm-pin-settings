#!/usr/bin/env python3
"""
Secure PIN for Linux — Native GTK4 / Libadwaita Settings Application
Matches GNOME Control Center design patterns.
"""

import sys
import os
import json
import subprocess
import shutil
import warnings

warnings.filterwarnings("ignore", category=DeprecationWarning)

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, Gio, GLib

APP_ID = "io.github.securepin.Settings"

class TpmPinSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = TpmPinMainWindow(application=self)
        win.present()


class TpmPinMainWindow(Adw.PreferencesWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.set_title("Secure PIN Settings")
        self.set_icon_name("io.github.securepin.Settings")
        self.set_default_size(720, 680)

        self._updating_ui = False
        self.ctl_path = self._find_ctl()
        self.state = self.load_status()

        self._build_ui()
        self.refresh_ui()

    def _is_flatpak(self):
        return os.path.exists("/.flatpak-info") or bool(os.environ.get("FLATPAK_ID"))

    def _find_ctl(self):
        if self._is_flatpak():
            return "tpm-pin-ctl"
        candidates = [
            "/usr/bin/tpm-pin-ctl",
            "/usr/local/bin/tpm-pin-ctl",
            shutil.which("tpm-pin-ctl"),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "build", "tpm-pin-ctl")),
            os.path.abspath(os.path.join(os.path.dirname(__file__), "tpm-pin-ctl")),
        ]
        for c in candidates:
            if c and os.path.isfile(c) and os.access(c, os.X_OK):
                return c
        return "tpm-pin-ctl"

    def run_ctl(self, args, need_root=False, input_text=None):
        if self._is_flatpak():
            cmd = ["flatpak-spawn", "--host"]
            if need_root:
                cmd += ["pkexec", self.ctl_path] + args
            else:
                cmd += [self.ctl_path] + args
        else:
            cmd = [self.ctl_path] + args
            if need_root and os.geteuid() != 0:
                cmd = ["pkexec"] + cmd
        try:
            res = subprocess.run(cmd, input=input_text, capture_output=True, text=True, check=True)
            return True, res.stdout.strip()
        except subprocess.CalledProcessError as e:
            return False, e.stderr.strip() or e.stdout.strip()
        except Exception as e:
            return False, str(e)

    def load_status(self):
        if self._is_flatpak():
            cmd = ["flatpak-spawn", "--host", self.ctl_path, "status", "--json"]
        else:
            cmd = [self.ctl_path, "status", "--json"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=True)
            data = json.loads(res.stdout)
            data["host_installed"] = True
            return data
        except Exception:
            host_installed = True
            if self._is_flatpak():
                try:
                    check = subprocess.run(["flatpak-spawn", "--host", "which", self.ctl_path],
                                           capture_output=True, text=True)
                    if check.returncode != 0:
                        host_installed = False
                except Exception:
                    host_installed = False

            return {
                "tpm_present": False if not host_installed else True,
                "tpm_manufacturer": "Host service missing" if not host_installed else "TPM 2.0",
                "host_installed": host_installed,
                "is_enrolled": False,
                "pcr7_bound": False,
                "keyring_pwd_saved": False,
                "pam_enabled": False,
                "distro": "Linux",
                "digits_only": True,
                "min_length": 4,
                "max_length": 32,
                "da_max_tries": 5,
                "da_recovery_time": 600,
                "enable_login": True,
                "enable_lockscreen": True,
                "enable_sudo": True,
                "enable_keyring_unlock": True,
            }

