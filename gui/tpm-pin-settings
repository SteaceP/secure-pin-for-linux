    def _is_flatpak(self):
        return os.path.exists("/.flatpak-info") or bool(os.environ.get("FLATPAK_ID"))

    def _find_ctl(self):
        if self._is_flatpak():
            return "/usr/bin/tpm-pin-ctl"
        system_candidates = [
            "/usr/bin/tpm-pin-ctl",
            "/usr/local/bin/tpm-pin-ctl",
        ]
        for c in system_candidates:
            if os.path.isfile(c) and os.access(c, os.X_OK):
                st = os.stat(c)
                if st.st_uid == 0 and (st.st_mode & 0o022) == 0:
                    return c
        if os.geteuid() == 0:
            dev_candidates = [
                os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "build", "tpm-pin-ctl")),
                os.path.abspath(os.path.join(os.path.dirname(__file__), "tpm-pin-ctl")),
            ]
            for c in dev_candidates:
                if os.path.isfile(c) and os.access(c, os.X_OK):
                    return c
        return "/usr/bin/tpm-pin-ctl"

    def run_ctl_raw(self, args, need_root=False, input_text=None):
        ctl = self.ctl_path
        if need_root and not self._is_flatpak() and not os.path.isfile(ctl):
            return -1, "", f"System binary not found: {ctl}"
        if self._is_flatpak():
            cmd = ["flatpak-spawn", "--host"]
            if need_root:
                cmd += ["pkexec", ctl] + args
            else:
                cmd += [ctl] + args
        else:
            cmd = [ctl] + args
            if need_root and os.geteuid() != 0:
                cmd = ["pkexec"] + cmd
        try:
            res = subprocess.run(cmd, input=input_text, capture_output=True, text=True, timeout=120)
            return res.returncode, res.stdout.strip(), res.stderr.strip()
        except subprocess.TimeoutExpired:
            return -1, "", "Command timed out."
        except Exception as e:
            return -1, "", str(e)

    def run_ctl(self, args, need_root=False, input_text=None):
        rc, out, err = self.run_ctl_raw(args, need_root=need_root, input_text=input_text)
        if rc == 0:
            return True, out
        return False, err or out

    def run_ctl_raw_async(self, args, callback, need_root=False, input_text=None):
        def worker():
            rc, out, err = self.run_ctl_raw(args, need_root=need_root, input_text=input_text)
            GLib.idle_add(callback, rc, out, err)
        threading.Thread(target=worker, daemon=True).start()

    def run_ctl_async(self, args, callback, need_root=False, input_text=None):
        def worker():
            ok, msg = self.run_ctl(args, need_root=need_root, input_text=input_text)
            GLib.idle_add(callback, ok, msg)
        threading.Thread(target=worker, daemon=True).start()

    def load_status(self):
        if self._is_flatpak():
            cmd = ["flatpak-spawn", "--host", self.ctl_path, "status", "--json"]
        else:
            cmd = [self.ctl_path, "status", "--json"]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, check=True, timeout=15)
            data = json.loads(res.stdout)
            data["host_installed"] = True
            return data
        except Exception:
            host_installed = True
            if self._is_flatpak():
                try:
                    check = subprocess.run(["flatpak-spawn", "--host", "test", "-x", self.ctl_path],
                                           capture_output=True, text=True, timeout=10)
                    if check.returncode != 0:
                        host_installed = False
                except Exception:
                    host_installed = False

            return {
                "version": APP_VERSION,
                "user": "unknown",
                "tpm_present": False,
                "tpm_accessible": False,
                "tpm_manufacturer": "Host service missing" if not host_installed else "TPM 2.0 (Not detected)",
                "host_installed": host_installed,
                "is_enrolled": False,
                "pcr7_bound": False,
