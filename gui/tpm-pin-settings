    def _update_banner(self):
        host_ok = self.state.get("host_installed", True)
        tpm_ok = self.state.get("tpm_present", False)
        enrolled = self.state.get("is_enrolled", False)
        pam_enabled = self.state.get("pam_enabled", False)
        locked_out = self.state.get("is_locked_out", False)
        pcr7_bound = self.state.get("pcr7_bound", False)
        bind_pcr7 = self.state.get("bind_pcr7", False)
        keyring_saved = self.state.get("keyring_pwd_saved", False)
        enable_keyring = self.state.get("enable_keyring_unlock", True)

        self._banner_action = None
        if not host_ok:
            self.banner.set_title("Host service (tpm-pin-ctl) is not installed on the host system.")
            self.banner.set_button_label("")
            self.banner.set_revealed(True)
        elif locked_out:
            self.banner.set_title("TPM Dictionary Attack lockout is active. Reset the lockout counter to re-enable PIN sign-in.")
            self.banner.set_button_label("Reset Lockout")
            self._banner_action = "reset_da"
            self.banner.set_revealed(True)
        elif enrolled and not pam_enabled:
            self.banner.set_title("Your PIN is enrolled, but PAM integration is currently disabled.")
            self.banner.set_button_label("Enable PAM")
            self._banner_action = "enable_pam"
            self.banner.set_revealed(True)
        elif enrolled and (bind_pcr7 != pcr7_bound):
            self.banner.set_title("PCR 7 policy changed since enrollment. Re-seal your PIN to apply the updated Secure Boot binding.")
            self.banner.set_button_label("Change PIN")
            self._banner_action = "change_pin"
            self.banner.set_revealed(True)
        elif enrolled and enable_keyring and not keyring_saved:
            self.banner.set_title("Keyring auto-unlock is enabled, but no login password is sealed yet.")
            self.banner.set_button_label("Re-enroll PIN")
            self._banner_action = "reenroll"
            self.banner.set_revealed(True)
        elif not tpm_ok:
            self.banner.set_title("No TPM 2.0 device detected. Hardware-backed PIN enrollment is unavailable.")
            self.banner.set_button_label("")
            self.banner.set_revealed(True)
        else:
            self.banner.set_button_label("")
            self.banner.set_revealed(False)

    def on_banner_action_clicked(self, banner):
        action = self._banner_action
        if action == "reset_da":
            self.on_reset_da_clicked(self.btn_reset_da)
        elif action == "enable_pam":
            if not self.sw_pam.get_active():
                self.sw_pam.set_active(True)
        elif action == "change_pin":
            ChangePinDialog(self).present()
        elif action == "reenroll":
            EnrollPinDialog(self).present()

    def _on_da_spin_changed(self, spin, pspec):
        if spin is self.spin_da_recovery:
            self.spin_da_recovery.set_subtitle(_format_duration(spin.get_value()))
        elif spin is self.spin_da_lockout:
            self.spin_da_lockout.set_subtitle(_format_duration(spin.get_value()))
        if not getattr(self, "_updating_ui", False):
            self._update_da_apply_sensitive()

    def _update_da_apply_sensitive(self):
        tries = int(self.spin_da_tries.get_value())
        rec = int(self.spin_da_recovery.get_value())
        lock = int(self.spin_da_lockout.get_value())
        changed = (
            tries != int(self.state.get("da_max_tries", 5)) or
            rec != int(self.state.get("da_recovery_time", 600)) or
            lock != int(self.state.get("da_lockout_recovery", 86400))
        )
        can_apply = changed and self.state.get("host_installed", True) and self.state.get("tpm_present", False)
        self.btn_apply_da.set_sensitive(can_apply)

    def _apply_state(self, state):
        self._updating_ui = True
        try:
            self.state = state

            tpm_ok = self.state.get("tpm_present", False)
            tpm_accessible = self.state.get("tpm_accessible", tpm_ok)
            mfg = self.state.get("tpm_manufacturer", "TPM 2.0")
            hw_type = self.state.get("hardware_type", "Standard TPM 2.0")
            bus_enc = self.state.get("bus_encryption", "Active (AES-128-CFB)")
            host_ok = self.state.get("host_installed", True)

            if not host_ok:
                self.row_tpm.set_subtitle("Host service not installed (install tpm-pin on host system)")
                self.row_hw.set_subtitle("Flatpak Sandbox (Host Integration)")
                self.row_bus.set_subtitle("Host daemon missing")
                self.btn_enroll.set_sensitive(False)
            elif not tpm_ok:
                self.btn_enroll.set_sensitive(False)
                self.row_tpm.set_subtitle("TPM 2.0 not detected — PIN enrollment disabled")
                self.row_hw.set_subtitle(hw_type)
                self.row_bus.set_subtitle("Inactive (No TPM device)")
            elif not tpm_accessible:
                self.btn_enroll.set_sensitive(True)
                self.row_tpm.set_subtitle(f"{mfg} — TPM detected (hardware protected — root/helper access)")
                self.row_hw.set_subtitle(hw_type)
                self.row_bus.set_subtitle(bus_enc)
            else:
                self.btn_enroll.set_sensitive(True)
                self.row_tpm.set_subtitle(f"{mfg} — Hardware security active")
                self.row_hw.set_subtitle(hw_type)
                self.row_bus.set_subtitle(bus_enc)

            distro = self.state.get("distro", "Linux")
            self.sw_pam.set_subtitle(f"Detected system: {distro} — Requires administrative authorization (pkexec)")

            user_name = self.state.get("user", "unknown")
            if user_name and user_name != "unknown":
                self.row_enroll.set_title(f"PIN Status ({user_name})")
            else:
                self.row_enroll.set_title("PIN Status")

            enrolled = self.state.get("is_enrolled", False)
            if enrolled:
                details = ["PIN configured and hardware-bound"]
                if self.state.get("pcr7_bound", False):
                    details.append("PCR 7 Bound")
                if self.state.get("keyring_pwd_saved", False):
                    details.append("Keyring Auto-Unlock")
                self.row_enroll.set_subtitle(" • ".join(details))
                self.btn_enroll.set_label("Change PIN")
                self.btn_test.set_visible(True)
                self.btn_test.set_sensitive(host_ok and tpm_ok)
                self.btn_remove.set_visible(True)
                self.btn_remove.set_sensitive(host_ok)
            else:
                self.row_enroll.set_subtitle("No PIN configured for this account")
                self.btn_enroll.set_label("Set Up PIN")
                self.btn_test.set_visible(False)
                self.btn_remove.set_visible(False)

            locked_out = self.state.get("is_locked_out", False)
            failed_tries = self.state.get("failed_tries", 0)
            max_tries = self.state.get("max_tries", 0)
            da_cfg_tries = self.state.get("da_max_tries", 5)
            if locked_out:
                self.row_da.set_subtitle(f"LOCKED OUT ({failed_tries}/{max_tries} failed attempts) — Click Reset Lockout")
            elif max_tries > 0:
                self.row_da.set_subtitle(f"Ready ({failed_tries}/{max_tries} hardware attempts used, policy max: {da_cfg_tries})")
            else:
                self.row_da.set_subtitle(f"{da_cfg_tries} max failed attempts before hardware rate-limit")

            self.btn_reset_da.set_sensitive(host_ok and tpm_ok)

            self.sw_login.set_active(bool(self.state.get("enable_login", True)))
            self.sw_lock.set_active(bool(self.state.get("enable_lockscreen", True)))
            self.sw_sudo.set_active(bool(self.state.get("enable_sudo", True)))
            self.sw_polkit.set_active(bool(self.state.get("enable_polkit", self.state.get("enable_sudo", True))))
            self.sw_keyring.set_active(bool(self.state.get("enable_keyring_unlock", True)))
            self.sw_pam.set_active(bool(self.state.get("pam_enabled", False)))

            self.sw_digits.set_active(bool(self.state.get("digits_only", True)))
            self.sw_simple.set_active(bool(self.state.get("disallow_simple_pins", True)))
            self.spin_min.set_value(int(self.state.get("min_length", 4)))
            self.spin_max.set_value(int(self.state.get("max_length", 32)))
            self.sw_pcr.set_active(bool(self.state.get("bind_pcr7", False)))

            da_rec = int(self.state.get("da_recovery_time", 600))
            da_lock = int(self.state.get("da_lockout_recovery", 86400))
            self.spin_da_tries.set_value(int(da_cfg_tries))
            self.spin_da_recovery.set_value(da_rec)
            self.spin_da_recovery.set_subtitle(_format_duration(da_rec))
            self.spin_da_lockout.set_value(da_lock)
            self.spin_da_lockout.set_subtitle(_format_duration(da_lock))
            self.btn_apply_da.set_sensitive(False)

            self._update_banner()
        finally:
            self._updating_ui = False

    def refresh_ui(self):
        self._apply_state(self.load_status())

    def refresh_ui_async(self, show_toast=False):
        self.btn_refresh.set_sensitive(False)

        def worker():
            state = self.load_status()
            GLib.idle_add(self._on_status_loaded, state, show_toast)
        threading.Thread(target=worker, daemon=True).start()

    def _on_status_loaded(self, state, show_toast=False):
        self.btn_refresh.set_sensitive(True)
        self._apply_state(state)
        if show_toast:
            self.add_toast(Adw.Toast.new("Status refreshed."))
        return GLib.SOURCE_REMOVE

    def on_refresh_clicked(self):
        self.refresh_ui_async(show_toast=True)
        if self.view_stack.get_visible_child_name() == "diagnostics":
            self.run_diagnostics(as_root=False)

    def on_config_toggle(self, switch, key):
        if getattr(self, "_updating_ui", False):
            return
        value = switch.get_active()
        if value == self.state.get(key):
            return
        switch.set_sensitive(False)

        def on_done(ok, msg):
            switch.set_sensitive(True)
            if ok:
                self.state[key] = value
                self._update_banner()
                if self.state.get("is_enrolled", False):
                    if key == "bind_pcr7":
                        self.add_toast(Adw.Toast.new("Use 'Change PIN' to re-seal your PIN with the updated PCR 7 setting."))
                    elif key == "enable_keyring_unlock" and value and not self.state.get("keyring_pwd_saved", False):
                        self.add_toast(Adw.Toast.new("Use 'Re-enroll PIN' to seal your login password for keyring auto-unlock."))
            else:
                self._updating_ui = True
                switch.set_active(not value)
                self._updating_ui = False
                if msg:
                    self._show_alert("Configuration Update Failed", msg)
            return GLib.SOURCE_REMOVE

        self.run_ctl_async(["config", "set", key, "true" if value else "false"], on_done, need_root=True)

    def on_config_set(self, spin, key):
        if getattr(self, "_updating_ui", False):
            return
        val = int(spin.get_value())
        if val == self.state.get(key):
            return
        spin.set_sensitive(False)

        def on_done(ok, msg):
            spin.set_sensitive(True)
            if ok:
                self.state[key] = val
                self._updating_ui = True
                try:
                    if key == "min_length" and val > self.state.get("max_length", 32):
                        self.state["max_length"] = val
                        self.spin_max.set_value(val)
                    elif key == "max_length" and val < self.state.get("min_length", 4):
                        self.state["min_length"] = val
                        self.spin_min.set_value(val)
                finally:
                    self._updating_ui = False
            else:
                self._updating_ui = True
                spin.set_value(self.state.get(key, 4))
                self._updating_ui = False
                if msg:
                    self._show_alert("Configuration Update Failed", msg)
            return GLib.SOURCE_REMOVE

        self.run_ctl_async(["config", "set", key, str(val)], on_done, need_root=True)

    def on_apply_da_clicked(self, btn):
        for spin in (self.spin_da_tries, self.spin_da_recovery, self.spin_da_lockout):
            if hasattr(spin, "update"):
                spin.update()

        max_tries = int(self.spin_da_tries.get_value())
        rec_sec = int(self.spin_da_recovery.get_value())
        lock_sec = int(self.spin_da_lockout.get_value())

        btn.set_sensitive(False)
        self.spin_da_tries.set_sensitive(False)
        self.spin_da_recovery.set_sensitive(False)
        self.spin_da_lockout.set_sensitive(False)

        def on_done(ok, msg):
            self.spin_da_tries.set_sensitive(True)
            self.spin_da_recovery.set_sensitive(True)
            self.spin_da_lockout.set_sensitive(True)
            if ok:
                self.refresh_ui_async()
                self.add_toast(Adw.Toast.new("TPM Dictionary Attack parameters updated."))
            else:
                self._update_da_apply_sensitive()
                self._show_alert("DA Policy Update Failed", msg or "Failed to update TPM DA parameters.")
            return GLib.SOURCE_REMOVE

        self.run_ctl_async(
            [
                "da-config",
                "--max-tries", str(max_tries),
                "--recovery-sec", str(rec_sec),
                "--lockout-recovery", str(lock_sec),
            ],
            on_done,
            need_root=True,
        )

    def on_pam_toggle(self, switch, gparam):
        if getattr(self, "_updating_ui", False):
            return
        active = switch.get_active()
        if active == self.state.get("pam_enabled", False):
            return
        cmd = "enable" if active else "disable"
        switch.set_sensitive(False)

        def on_done(ok, msg):
            switch.set_sensitive(True)
            if not ok:
                self._updating_ui = True
                switch.set_active(not active)
                self._updating_ui = False
                self._show_alert("PAM Configuration Error", msg)
            else:
                self.refresh_ui_async()
                self.add_toast(Adw.Toast.new("PAM integration enabled." if active else "PAM integration disabled."))
            return GLib.SOURCE_REMOVE

        self.run_ctl_async(["pam", cmd], on_done, need_root=True)

    def on_reset_da_clicked(self, btn):
        btn.set_sensitive(False)

        def on_done(ok, msg):
