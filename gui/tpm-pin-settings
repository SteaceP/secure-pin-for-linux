        page.add(grp)
        toolbar.set_content(page)
        self.set_content(toolbar)

    def on_save(self, btn):
        if self._busy:
            return
        pwd = self.row_pwd.get_text() if self.need_pwd else ""
        confirm_pwd = self.row_pwd_confirm.get_text() if self.need_pwd else ""
        pin = self.row_pin.get_text()
        confirm = self.row_confirm.get_text()

        if self.need_pwd and not pwd:
            self._show_err("Please enter your current login password (or disable Auto-Unlock Desktop Keyring).")
            return
        if self.need_pwd and pwd != confirm_pwd:
            self._show_err("Login passwords do not match.")
            return
        if (self.need_pwd and (_has_control_chars(pwd) or _has_control_chars(confirm_pwd))) or \
           _has_control_chars(pin) or _has_control_chars(confirm):
            self._show_err("PIN and password cannot contain newline or control characters.")
            return
        if pin != confirm:
            self._show_err("PINs do not match.")
            return

        err_msg = _validate_pin_client(pin, self.parent_win.state)
        if err_msg:
            self._show_err(err_msg)
            return

        input_data = f"{pwd}\n{confirm_pwd}\n{pin}\n{confirm}\n" if self.need_pwd else f"{pin}\n{confirm}\n"

        if self.need_pwd:
            self.row_pwd.set_text("")
            self.row_pwd_confirm.set_text("")
        self.row_pin.set_text("")
        self.row_confirm.set_text("")

        self._busy = True
        self.btn_save.set_sensitive(False)
        self.btn_cancel.set_sensitive(False)

        target_user = self.parent_win.state.get("user")
        cmd = ["enroll", "--user", target_user] if target_user and target_user != "unknown" else ["enroll"]

        def on_done(ok, msg):
            self._busy = False
            self.btn_save.set_sensitive(True)
            self.btn_cancel.set_sensitive(True)
            if ok:
                self.close()
                self.parent_win.refresh_ui_async()
                self.parent_win.add_toast(Adw.Toast.new("PIN enrolled and sealed in TPM 2.0."))
            else:
                self._show_err(f"Enrollment failed: {msg}")
            return GLib.SOURCE_REMOVE

        self.parent_win.run_ctl_async(cmd, on_done, need_root=True, input_text=input_data)

    def _show_err(self, msg):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Invalid Input",
            body=msg
        )
        dialog.add_response("ok", "OK")
        dialog.present()


