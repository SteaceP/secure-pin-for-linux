    def run_diagnostics(self, as_root=False):
        self.btn_diag_run.set_sensitive(False)
        self.btn_diag_root.set_sensitive(False)
        self.row_diag_summary.set_title("Running Diagnostics…")
        self.row_diag_summary.set_subtitle("Inspecting TPM hardware, PAM integration, and system configuration")

        target_user = self.state.get("user")
        cmd = ["doctor", "--json"]
        if target_user and target_user != "unknown":
            cmd += ["--user", target_user]

        def on_done(rc, out, err):
            self.btn_diag_run.set_sensitive(True)
            self.btn_diag_root.set_sensitive(True)
            self._clear_diag_rows()

            parsed = None
            if out.startswith("{"):
                try:
                    parsed = json.loads(out)
                except Exception:
                    parsed = None

            if parsed is None:
                self.row_diag_summary.set_title("Diagnostics Failed")
                self.row_diag_summary.set_subtitle(err or out or "Unable to run tpm-pin-ctl doctor.")
                self.btn_diag_copy.set_sensitive(False)
                self._last_diag_report = ""
                return GLib.SOURCE_REMOVE

            passed = parsed.get("pass", 0)
            warned = parsed.get("warn", 0)
            failed = parsed.get("fail", 0)
            checks = parsed.get("checks", [])

            if failed > 0:
                self.row_diag_summary.set_title(f"{failed} Issue{'s' if failed != 1 else ''} Detected")
            elif warned > 0:
                self.row_diag_summary.set_title(f"Healthy with {warned} Warning{'s' if warned != 1 else ''}")
            else:
                self.row_diag_summary.set_title("All Systems Healthy")
            self.row_diag_summary.set_subtitle(f"{passed} passed • {warned} warnings • {failed} failures")

            icon_map = {
                "pass": ("emblem-ok-symbolic", "success"),
                "warn": ("dialog-warning-symbolic", "warning"),
                "fail": ("dialog-error-symbolic", "error"),
                "info": ("dialog-information-symbolic", "dim-label"),
            }

            report_lines = [
                f"Secure PIN for Linux {parsed.get('version', APP_VERSION)} Diagnostics",
                f"User: {parsed.get('user', 'unknown')} (UID {parsed.get('uid', '')})",
                f"Summary: {passed} passed, {warned} warnings, {failed} failures",
                "",
            ]

            for item in checks:
                status = item.get("status", "info")
                title = item.get("title", item.get("id", "Check"))
                detail = item.get("detail", "")
                icon_name, css_cls = icon_map.get(status, ("dialog-information-symbolic", "dim-label"))

                row = Adw.ActionRow()
                row.set_use_markup(False)
                row.set_title(title)
                row.set_subtitle(detail)
                img = Gtk.Image.new_from_icon_name(icon_name)
                img.add_css_class(css_cls)
                row.add_prefix(img)
                self.grp_diag_results.add(row)
                self._diag_rows.append(row)

                report_lines.append(f"[{status.upper()}] {title}: {detail}")

            self._last_diag_report = "\n".join(report_lines)
            self.btn_diag_copy.set_sensitive(True)
            return GLib.SOURCE_REMOVE

        self.run_ctl_raw_async(cmd, on_done, need_root=as_root)

    def on_copy_diag_clicked(self, btn):
        if not self._last_diag_report:
            return
        display = Gdk.Display.get_default()
        if display:
