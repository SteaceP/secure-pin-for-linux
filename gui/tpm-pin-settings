        grp_status.set_title("Authentication Status")

        self.row_tpm = Adw.ActionRow()
        self.row_tpm.set_title("TPM 2.0 Security Processor")
        self.row_tpm.set_subtitle("Checking hardware...")
        self.row_tpm.add_prefix(Gtk.Image.new_from_icon_name("security-high-symbolic"))
        grp_status.add(self.row_tpm)

        self.row_hw = Adw.ActionRow()
        self.row_hw.set_title("Hardware Architecture")
        self.row_hw.set_subtitle("Detecting...")
        self.row_hw.add_prefix(Gtk.Image.new_from_icon_name("computer-symbolic"))
        grp_status.add(self.row_hw)

        self.row_bus = Adw.ActionRow()
        self.row_bus.set_title("Bus Sniffing Protection")
        self.row_bus.set_subtitle("Active (AES-128-CFB encrypted transit sessions)")
        self.row_bus.add_prefix(Gtk.Image.new_from_icon_name("channel-secure-symbolic"))
        grp_status.add(self.row_bus)

        self.row_enroll = Adw.ActionRow()
        self.row_enroll.set_title("PIN Status")
        self.row_enroll.set_subtitle("Not enrolled")
        self.row_enroll.add_prefix(Gtk.Image.new_from_icon_name("avatar-default-symbolic"))

        self.btn_enroll = Gtk.Button(label="Set Up PIN")
        self.btn_enroll.add_css_class("suggested-action")
        self.btn_enroll.set_valign(Gtk.Align.CENTER)
        self.btn_enroll.connect("clicked", self.on_setup_pin_clicked)
        self.row_enroll.add_suffix(self.btn_enroll)

        self.btn_remove = Gtk.Button(label="Remove PIN")
        self.btn_remove.add_css_class("destructive-action")
        self.btn_remove.set_valign(Gtk.Align.CENTER)
        self.btn_remove.connect("clicked", self.on_remove_pin_clicked)
        self.row_enroll.add_suffix(self.btn_remove)

        grp_status.add(self.row_enroll)
        page1.add(grp_status)

        # Group: Where to use PIN
        grp_scopes = Adw.PreferencesGroup()
        grp_scopes.set_title("Authentication Scope")
        grp_scopes.set_description("Select where the TPM PIN can be used to authenticate.")

        self.sw_login = Adw.SwitchRow()
        self.sw_login.set_title("Login Screen")
        self.sw_login.set_subtitle("Unlock user session at boot (GDM / SDDM)")
        self.sw_login.connect("notify::active", lambda s, p: self.on_config_toggle(s, "enable_login"))
        grp_scopes.add(self.sw_login)

        self.sw_lock = Adw.SwitchRow()
        self.sw_lock.set_use_markup(False)
        self.sw_lock.set_title("Lock Screen & Polkit")
        self.sw_lock.set_subtitle("Unlock locked desktop and approve graphical admin prompts")
        self.sw_lock.connect("notify::active", lambda s, p: self.on_config_toggle(s, "enable_lockscreen"))
        grp_scopes.add(self.sw_lock)

        self.sw_sudo = Adw.SwitchRow()
        self.sw_sudo.set_title("Terminal Sudo")
        self.sw_sudo.set_subtitle("Authorize sudo commands in terminal")
        self.sw_sudo.connect("notify::active", lambda s, p: self.on_config_toggle(s, "enable_sudo"))
        grp_scopes.add(self.sw_sudo)

        self.sw_keyring = Adw.SwitchRow()
        self.sw_keyring.set_title("Auto-Unlock Desktop Keyring")
        self.sw_keyring.set_subtitle("Automatically unlock GNOME Keyring / KWallet on login")
        self.sw_keyring.connect("notify::active", lambda s, p: self.on_config_toggle(s, "enable_keyring_unlock"))
        grp_scopes.add(self.sw_keyring)

        page1.add(grp_scopes)

        # Group: System PAM Integration
        grp_pam = Adw.PreferencesGroup()
        grp_pam.set_title("System PAM Integration")
        grp_pam.set_description("Enable or disable the PAM module in system authentication files.")

        self.sw_pam = Adw.SwitchRow()
        self.sw_pam.set_title("Enable TPM PIN in PAM")
        self.sw_pam.set_subtitle("Requires administrative authorization (pkexec)")
        self.sw_pam.connect("notify::active", self.on_pam_toggle)
        grp_pam.add(self.sw_pam)

        page1.add(grp_pam)
        self.add(page1)

        # Page 2: Security & Hardware
        page2 = Adw.PreferencesPage()
        page2.set_title("Security & TPM")
        page2.set_icon_name("system-lock-screen-symbolic")

        # Group: PIN Policy
        grp_policy = Adw.PreferencesGroup()
        grp_policy.set_title("PIN Complexity Policy")

        self.sw_digits = Adw.SwitchRow()
        self.sw_digits.set_title("Digits-Only PIN")
        self.sw_digits.set_subtitle("Restrict PIN to numeric characters (0-9)")
        self.sw_digits.connect("notify::active", lambda s, p: self.on_config_toggle(s, "digits_only"))
        grp_policy.add(self.sw_digits)

        self.spin_min = Adw.SpinRow.new_with_range(4, 16, 1)
        self.spin_min.set_title("Minimum PIN Length")
        self.spin_min.connect("notify::value", lambda s, p: self.on_config_set(s, "min_length"))
        grp_policy.add(self.spin_min)

        self.spin_max = Adw.SpinRow.new_with_range(8, 64, 1)
        self.spin_max.set_title("Maximum PIN Length")
        self.spin_max.connect("notify::value", lambda s, p: self.on_config_set(s, "max_length"))
        grp_policy.add(self.spin_max)

        page2.add(grp_policy)

        # Group: Hardware TPM Controls
        grp_tpm = Adw.PreferencesGroup()
        grp_tpm.set_title("Hardware Anti-Hammering &amp; Boot Protection")

        self.sw_pcr = Adw.SwitchRow()
        self.sw_pcr.set_title("Bind to Secure Boot (PCR 7)")
        self.sw_pcr.set_subtitle("Disables PIN if firmware, bootloader, or Secure Boot state is tampered with")
        self.sw_pcr.connect("notify::active", lambda s, p: self.on_config_toggle(s, "bind_pcr7"))
        grp_tpm.add(self.sw_pcr)

        self.row_da = Adw.ActionRow()
        self.row_da.set_title("Dictionary Attack Lockout")
        self.row_da.set_subtitle(f"{self.state.get('da_max_tries', 5)} max failed attempts before hardware rate-limit")
        btn_reset_da = Gtk.Button(label="Reset Lockout")
        btn_reset_da.set_valign(Gtk.Align.CENTER)
