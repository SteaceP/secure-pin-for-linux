    def refresh_ui(self):
        self._updating_ui = True
        try:
            self.state = self.load_status()

            tpm_ok = self.state.get("tpm_present", False)
            mfg = self.state.get("tpm_manufacturer", "TPM 2.0")
            hw_type = self.state.get("hardware_type", "Standard TPM 2.0")
            bus_enc = self.state.get("bus_encryption", "Active (AES-128-CFB)")
            if not self.state.get("host_installed", True):
                self.row_tpm.set_subtitle("Host service not installed (install tpm-pin on host system)")
                self.row_hw.set_subtitle("Flatpak Sandbox (Host Integration)")
                self.row_bus.set_subtitle("Host daemon missing")
                self.btn_enroll.set_sensitive(False)
            elif not tpm_ok:
                self.btn_enroll.set_sensitive(False)
                self.row_tpm.set_subtitle("TPM 2.0 not detected — PIN enrollment disabled")
                self.row_hw.set_subtitle(hw_type)
                self.row_bus.set_subtitle("Inactive (No TPM device)")
            else:
                self.btn_enroll.set_sensitive(True)
                self.row_tpm.set_subtitle(f"{mfg} — Hardware security active")
                self.row_hw.set_subtitle(hw_type)
                self.row_bus.set_subtitle(bus_enc)

            enrolled = self.state.get("is_enrolled", False)
            if enrolled:
                details = ["PIN configured and hardware-bound"]
                if self.state.get("pcr7_bound", False):
                    details.append("PCR 7 Bound")
                if self.state.get("keyring_pwd_saved", False):
                    details.append("Keyring Auto-Unlock")
                self.row_enroll.set_subtitle(" • ".join(details))
                self.btn_enroll.set_label("Change PIN")
                self.btn_remove.set_visible(True)
            else:
                self.row_enroll.set_subtitle("No PIN configured for this account")
                self.btn_enroll.set_label("Set Up PIN")
                self.btn_remove.set_visible(False)

            locked_out = self.state.get("is_locked_out", False)
            failed_tries = self.state.get("failed_tries", 0)
            max_tries = self.state.get("max_tries", 0)
            da_cfg_tries = self.state.get("da_max_tries", 5)
            if locked_out:
                self.row_da.set_subtitle(f"LOCKED OUT ({failed_tries}/{max_tries} failed attempts) — Click Reset Lockout")
            elif max_tries > 0:
                self.row_da.set_subtitle(f"Ready ({failed_tries}/{max_tries} hardware attempts used, policy max: {da_cfg_tries})")
            else:
                self.row_da.set_subtitle(f"{da_cfg_tries} max failed attempts before hardware rate-limit")

            self.sw_login.set_active(self.state.get("enable_login", True))
            self.sw_lock.set_active(self.state.get("enable_lockscreen", True))
            self.sw_sudo.set_active(self.state.get("enable_sudo", True))
            self.sw_keyring.set_active(self.state.get("enable_keyring_unlock", True))
            self.sw_pam.set_active(self.state.get("pam_enabled", False))

            self.sw_digits.set_active(self.state.get("digits_only", True))
            self.spin_min.set_value(self.state.get("min_length", 4))
            self.spin_max.set_value(self.state.get("max_length", 32))
            self.sw_pcr.set_active(self.state.get("bind_pcr7", False))
        finally:
            self._updating_ui = False

    def on_config_toggle(self, switch, key):
        if getattr(self, "_updating_ui", False):
            return
        value = switch.get_active()
        if value == self.state.get(key):
            return
        ok, msg = self.run_ctl(["config", "set", key, "true" if value else "false"], need_root=True)
        if ok:
            self.state[key] = value
        else:
            self._updating_ui = True
            switch.set_active(not value)
            self._updating_ui = False
            if msg:
                self._show_alert("Configuration Update Failed", msg)

    def on_config_set(self, spin, key):
        if getattr(self, "_updating_ui", False):
            return
        val = int(spin.get_value())
        if val == self.state.get(key):
            return
        ok, msg = self.run_ctl(["config", "set", key, str(val)], need_root=True)
        if ok:
            self.state[key] = val
        else:
            self._updating_ui = True
            spin.set_value(self.state.get(key, 4))
            self._updating_ui = False
            if msg:
                self._show_alert("Configuration Update Failed", msg)

    def on_pam_toggle(self, switch, gparam):
        if getattr(self, "_updating_ui", False):
            return
        active = switch.get_active()
        if active == self.state.get("pam_enabled", False):
            return
        cmd = "enable" if active else "disable"
        ok, msg = self.run_ctl(["pam", cmd], need_root=True)
        if not ok:
            # Revert switch state without re-triggering signal
            self._updating_ui = True
            switch.set_active(not active)
            self._updating_ui = False
            self._show_alert("PAM Configuration Error", msg)
        else:
            self.refresh_ui()

    def on_reset_da_clicked(self, btn):
        ok, msg = self.run_ctl(["da-reset"], need_root=True)
        if ok:
            self.refresh_ui()
            self._show_alert("Success", "TPM Dictionary Attack lockout counter has been reset.")
        else:
            self._show_alert("Lockout Reset Failed", msg)

    def on_remove_pin_clicked(self, btn):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Remove PIN?",
            body="Are you sure you want to remove your PIN? You will need to use your standard password."
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("remove", "Remove")
        dialog.set_response_appearance("remove", Adw.ResponseAppearance.DESTRUCTIVE)

        def on_response(d, resp):
            if resp == "remove":
                target_user = self.state.get("user")
                cmd = ["remove", "--user", target_user] if target_user and target_user != "unknown" else ["remove"]
                ok, msg = self.run_ctl(cmd, need_root=True)
                if not ok and msg:
                    self._show_alert("Remove PIN Failed", msg)
                self.refresh_ui()

        dialog.connect("response", on_response)
        dialog.present()

    def on_setup_pin_clicked(self, btn):
        dialog = EnrollPinDialog(self)
        dialog.present()

    def _show_alert(self, title, msg):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading=title,
            body=msg
        )
        dialog.add_response("ok", "OK")
        dialog.present()


class EnrollPinDialog(Adw.PreferencesWindow):
    def __init__(self, parent_win):
        super().__init__()
        self.set_transient_for(parent_win)
        self.set_modal(True)
        self.set_title("Set Up PIN")
        self.set_default_size(480, 420)
        self.parent_win = parent_win
        self.need_pwd = self.parent_win.state.get("enable_keyring_unlock", True)

        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup()
        grp.set_title("Enter PIN Details")

        self.row_pwd = Adw.PasswordEntryRow()
        self.row_pwd.set_title("Current Login Password")
        if self.need_pwd:
            grp.add(self.row_pwd)

        self.row_pin = Adw.PasswordEntryRow()
        self.row_pin.set_title("New PIN")
        grp.add(self.row_pin)

        self.row_confirm = Adw.PasswordEntryRow()
        self.row_confirm.set_title("Confirm PIN")
        grp.add(self.row_confirm)

        page.add(grp)
        self.add(page)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        btn_box.set_halign(Gtk.Align.END)
        btn_box.set_margin_top(16)
        btn_box.set_margin_bottom(16)
        btn_box.set_margin_end(16)

        btn_cancel = Gtk.Button(label="Cancel")
        btn_cancel.connect("clicked", lambda b: self.close())
        btn_box.append(btn_cancel)

        btn_save = Gtk.Button(label="Save PIN")
        btn_save.add_css_class("suggested-action")
        btn_save.connect("clicked", self.on_save)
        btn_box.append(btn_save)

        grp.add(btn_box)

    def on_save(self, btn):
        pwd = self.row_pwd.get_text() if self.need_pwd else ""
        pin = self.row_pin.get_text()
        confirm = self.row_confirm.get_text()

        if pin != confirm:
            self._show_err("PINs do not match.")
            return

        min_len = int(self.parent_win.state.get("min_length", 4))
        max_len = int(self.parent_win.state.get("max_length", 32))
        digits_only = bool(self.parent_win.state.get("digits_only", True))

        if len(pin) < min_len:
            self._show_err(f"PIN is too short (minimum {min_len} characters required).")
            return
        if len(pin) > max_len:
            self._show_err(f"PIN is too long (maximum {max_len} characters allowed).")
            return
        if digits_only and not pin.isdigit():
            self._show_err("PIN must contain numbers only (0-9).")
            return
        if len(pin) >= 4 and len(set(pin)) == 1:
            self._show_err("PIN cannot consist of all identical characters.")
            return

        # Pass secrets securely over stdin pipe rather than cmdline argv
        input_data = f"{pwd}\n{pin}\n{confirm}\n" if self.need_pwd else f"{pin}\n{confirm}\n"
        target_user = self.parent_win.state.get("user")
        cmd = ["enroll", "--user", target_user] if target_user and target_user != "unknown" else ["enroll"]
        ok, msg = self.parent_win.run_ctl(cmd, need_root=True, input_text=input_data)
        if ok:
            self.close()
            self.parent_win.refresh_ui()
        else:
            self._show_err(f"Enrollment failed: {msg}")

    def _show_err(self, msg):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Invalid Input",
            body=msg
        )
        dialog.add_response("ok", "OK")
        dialog.present()


def main():
    app = TpmPinSettingsApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
