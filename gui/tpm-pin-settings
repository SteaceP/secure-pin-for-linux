def _has_control_chars(value):
    return any(ord(ch) < 0x20 or ord(ch) == 0x7F for ch in value)


def _is_sequential_pin(pin):
    raw = pin if isinstance(pin, (bytes, bytearray)) else pin.encode("utf-8")
    if len(raw) < 4:
        return False
    diffs = [raw[i] - raw[i - 1] for i in range(1, len(raw))]
    return all(d == 1 for d in diffs) or all(d == -1 for d in diffs)


def _is_repeating_pin(pin):
    raw = pin if isinstance(pin, (bytes, bytearray)) else pin.encode("utf-8")
    n = len(raw)
    if n < 4:
        return False
    for period in range(2, (n // 2) + 1):
        if n % period != 0 and period != 2:
            continue
        if all(raw[i] == raw[i % period] for i in range(period, n)):
            return True
    return False


def _validate_pin_client(pin, state):
    if not pin:
        return "PIN cannot be empty."
    if _has_control_chars(pin):
        return "PIN cannot contain newline or control characters."

    min_len = int(state.get("min_length", 4))
    max_len = int(state.get("max_length", 32))
    digits_only = bool(state.get("digits_only", True))
    disallow_simple = bool(state.get("disallow_simple_pins", True))
    raw_bytes = pin.encode("utf-8")
    pin_byte_len = len(raw_bytes)

    if pin_byte_len < min_len:
        return f"PIN is too short (minimum {min_len} bytes required)."
    if pin_byte_len > max_len:
        return f"PIN is too long (maximum {max_len} bytes allowed)."
    if digits_only and not (pin.isascii() and pin.isdigit()):
        return "PIN must contain ASCII numbers only (0-9)."
    if pin_byte_len >= 4 and len(set(raw_bytes)) == 1:
        return "PIN cannot consist of all identical characters."
    if disallow_simple:
        if _is_sequential_pin(raw_bytes):
            return "PIN cannot be a simple sequential pattern (e.g. 1234 or 4321)."
        if _is_repeating_pin(raw_bytes):
            return "PIN cannot be a simple repeating pattern (e.g. 1212 or 123123)."
    return None


def _format_duration(seconds):
    secs = int(seconds)
    if secs >= 86400 and secs % 86400 == 0:
        days = secs // 86400
        return f"{days} {'day' if days == 1 else 'days'} ({secs} s)"
    if secs >= 3600 and secs % 3600 == 0:
        hrs = secs // 3600
        return f"{hrs} {'hour' if hrs == 1 else 'hours'} ({secs} s)"
    if secs >= 60 and secs % 60 == 0:
        mins = secs // 60
        return f"{mins} {'min' if mins == 1 else 'mins'} ({secs} s)"
    return f"{secs} s"


